// Jodhpur National University — database schema
//
// SQLite by default so the project clones and runs with no external service:
//   npx prisma migrate dev  &&  npm run dev
//
// To host it (Vercel + a hosted Postgres such as Neon), change the provider
// below to "postgresql" and point DATABASE_URL at the connection string.
// Nothing else in the schema changes. See DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, for queries. On a serverless host every function
  // instance opens its own connections, and Postgres' direct connection
  // limit is reached long before the traffic justifies it.
  url      = env("DATABASE_URL")
  // Direct connection, for migrations only. `prisma migrate` takes advisory
  // locks, which a transaction pooler does not carry through — against the
  // pooled URL it can hang instead of failing.
  directUrl = env("DIRECT_URL")
}

/// Staff accounts. Passwords are stored only as a bcrypt hash — never in
/// plain text, and never sent back to the client.
model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  /// admin | registrar | exam_cell | editor — see src/lib/permissions.ts
  role         String   @default("editor")
  createdAt    DateTime @default(now())

  /// Forces a password change at next sign-in: set when an admin creates the
  /// account or resets the password, so the temporary one is used only once.
  mustChangePassword Boolean   @default(false)
  disabled           Boolean   @default(false)
  lastLoginAt        DateTime?

  auditEntries AuditLog[]
}

/// One examination result for a student, in one semester, in one session.
model Result {
  id            String    @id @default(cuid())
  rollNo        String
  studentName   String
  programme     String
  semester      String
  examSession   String
  /// Subject rows as JSON — SQLite has no native JSON column type.
  subjects      String    @default("[]")
  marksObtained Int       @default(0)
  marksMax      Int       @default(0)
  sgpa          Float     @default(0)
  /// PASS | FAIL | ATKT | WITHHELD
  status        String    @default("PASS")
  /// Nothing is visible to students until the exam cell publishes it.
  published     Boolean   @default(false)
  publishedAt   DateTime?
  /// Serial printed on the statement of marks and encoded in its QR code.
  ///
  /// Random, not sequential: anyone holding the printed sheet can look the
  /// record up at /verify/marksheet/ with it, so it must not be guessable
  /// from a neighbouring serial. It is what makes a printout checkable — a
  /// sheet edited before printing will not match the record this returns.
  /// Issued when the result is first published and never changed after.
  verifyToken   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Set once the roll number matches a row in Student. Nullable because the
  /// exam cell can import results before the student register is populated;
  /// the lookup falls back to rollNo when it is null.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // A student sits a given semester in a given session exactly once.
  @@unique([rollNo, semester, examSession])
  // The public lookup always filters on both columns.
  @@index([rollNo, published])
}

/// Register of certificates the university has issued, backing public
/// verification at /verify/.
model Certificate {
  id               String   @id @default(cuid())
  certificateNo    String   @unique
  studentName      String
  programme        String
  awardYear        Int
  enrollmentNo     String
  division         String
  /// VERIFIED | REVOKED | WITHHELD
  status           String   @default("VERIFIED")
  registrarRemarks String?
  /// Serial printed on the degree with its QR code; resolves to this entry at
  /// /verify/certificate/. Random rather than sequential, unlike the
  /// certificate number, so a serial read off one degree says nothing about
  /// another. Issued once and never changed.
  verifyToken      String?  @unique
  issuedOn         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Verification is now by roll number + date of birth, so the register has
  /// to carry the roll number as well as the certificate number.
  rollNo    String?
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([certificateNo])
  @@index([rollNo])
}

/// Append-only trail. Results and certificates are the records most worth
/// tampering with, so every write is logged with who did it.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Staff?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  detail     String
  at         DateTime @default(now())

  @@index([at])
}

/// Contact-form submissions, routed to the relevant office.
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  programme String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The student register.
///
/// Keystone for three public features that previously had nothing to stand on:
/// student login, certificate verification by roll number, and the fuller
/// marksheet. Before this, Result carried a roll number but no date of birth,
/// and Certificate carried an enrollment number but no roll number, so none of
/// the three could be answered.
model Student {
  id           String  @id @default(cuid())
  rollNo       String  @unique
  enrollmentNo String  @unique
  fullName     String
  fatherName   String
  motherName   String
  /// Stored as a plain `YYYY-MM-DD` string, deliberately NOT DateTime.
  ///
  /// It is half of a login credential, so it is only ever compared for exact
  /// equality. A DateTime would be written at midnight in one zone and read
  /// back as the previous day in another, locking a student out of their own
  /// record. A date of birth has no time and no zone; storing it as text says
  /// so and removes the whole class of bug.
  dob          String
  programme    String
  /// Upload id for the live passport photograph. Served only through an
  /// authenticated route — never from /public.
  photoId      String?
  photo        Upload? @relation("StudentPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  /// A photograph the student has uploaded that staff have not approved yet.
  ///
  /// Held separately from photoId so the existing photo stays on the record
  /// until someone approves the replacement. A student's own upload must not
  /// appear unreviewed next to their marks on a page that looks like an
  /// official university document.
  pendingPhotoId String?
  pendingPhoto   Upload?   @relation("StudentPendingPhoto", fields: [pendingPhotoId], references: [id], onDelete: SetNull)
  pendingPhotoAt DateTime?

  /// ---- Contact details ----
  ///
  /// The ONLY fields on this model a student may change themselves. Identity
  /// fields above (name, parents, date of birth, roll and enrollment numbers)
  /// are deliberately not editable: they are what certificate verification
  /// checks against, so a self-service edit would let someone align their
  /// record to a forged document and have the register confirm it. A date of
  /// birth is also half the login credential. Corrections to those go through
  /// CorrectionRequest and a member of staff.
  mobile      String?
  email       String?
  addressLine String?
  district    String?
  state       String?
  pincode     String?

  /// ACTIVE | GRADUATED | WITHDRAWN
  status String @default("ACTIVE")

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results      Result[]
  certificates Certificate[]
  corrections  CorrectionRequest[]

  // Both halves of the login are matched together.
  @@index([rollNo, dob])
}

/// An admission application submitted from /admission/process/.
model Application {
  id            String @id @default(cuid())
  applicationNo String @unique

  fullName   String
  fatherName String
  motherName String
  /// `YYYY-MM-DD`, for the same reason as Student.dob.
  dob        String

  mobile String
  email  String

  state    String
  district String
  address  String
  pincode  String

  programme String

  qualification      String
  qualificationBoard String?
  qualificationYear  Int?
  qualificationPct   Float?

  /// Uploaded documents. Nullable so a part-complete application still saves.
  photoId            String?
  photo              Upload? @relation("ApplicationPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  aadhaarId          String?
  aadhaar            Upload? @relation("ApplicationAadhaar", fields: [aadhaarId], references: [id], onDelete: SetNull)
  qualificationDocId String?
  qualificationDoc   Upload? @relation("ApplicationQualification", fields: [qualificationDocId], references: [id], onDelete: SetNull)

  /// Last four digits ONLY.
  ///
  /// The full Aadhaar number is never stored. UIDAI requires masking for
  /// entities that are not authorised authentication agencies, and the DPDP
  /// Act 2023 makes storing more than is needed a liability rather than an
  /// asset. Four digits is enough for an office to match an applicant to the
  /// document they uploaded, which is the only thing it is needed for.
  aadhaarLast4 String?

  /// SUBMITTED | UNDER_REVIEW | ACCEPTED | REJECTED
  status  String  @default("SUBMITTED")
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// A file someone uploaded.
///
/// Rows here are metadata only; the bytes live behind `storageKey`, outside
/// /public, and are served by an authenticated route. Putting an Aadhaar scan
/// or a student photograph under /public would publish it at a guessable URL
/// the moment it was written.
model Upload {
  id          String   @id @default(cuid())
  /// Opaque key for the storage backend (local disk today, object storage in
  /// production — see src/lib/storage.ts).
  storageKey  String   @unique
  filename    String
  contentType String
  bytes       Int
  /// PHOTO | AADHAAR | QUALIFICATION
  kind        String
  createdAt   DateTime @default(now())

  students                  Student[]     @relation("StudentPhoto")
  pendingStudents           Student[]     @relation("StudentPendingPhoto")
  applicationPhotos         Application[] @relation("ApplicationPhoto")
  applicationAadhaars       Application[] @relation("ApplicationAadhaar")
  applicationQualifications Application[] @relation("ApplicationQualification")
  counsellingPhotos         Counselling[] @relation("CounsellingPhoto")
  counsellingAadhaars       Counselling[] @relation("CounsellingAadhaar")
}

/// A request for online counselling, submitted from the public site.
///
/// This is lead capture, not an admission: nobody has applied to anything
/// yet. That is why every document is optional and no Aadhaar number is
/// taken at all. Under the DPDP Act 2023 the lawful amount of personal data
/// is the amount the purpose needs, and the purpose here is for a counsellor
/// to ring someone back. Identity is established later, at admission, by
/// Application — which already collects and masks it properly.
model Counselling {
  id        String @id @default(cuid())
  reference String @unique

  /// The counsellor or consultancy submitting on the student's behalf.
  counsellorName String

  firstName String
  lastName  String
  email     String
  mobile    String

  state    String
  district String
  city     String

  /// Optional supporting files, stored exactly as admission documents are:
  /// outside public/, reachable only through /api/uploads/[id] behind a
  /// session check.
  photoId   String?
  photo     Upload? @relation("CounsellingPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  aadhaarId String?
  aadhaar   Upload? @relation("CounsellingAadhaar", fields: [aadhaarId], references: [id], onDelete: SetNull)

  /// NEW | CONTACTED | CLOSED
  status  String  @default("NEW")
  remarks String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Fixed-window rate limiting, in the database rather than in memory.
///
/// Roll number + date of birth is a guessable credential: roll numbers run in
/// sequence and a cohort's dates of birth span only a few years. In-process
/// counters would reset on every cold start, which on a serverless host is
/// often enough to be no limit at all. A row per (bucket, key) survives that.
model RateLimit {
  id          String   @id @default(cuid())
  /// e.g. "student-login" | "verify"
  bucket      String
  /// Client IP, or IP + roll number.
  key         String
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([bucket, key])
  @@index([windowStart])
}

/// A student's request to change a field they cannot edit themselves.
///
/// The safety valve for the read-only identity fields on Student. A student
/// who spots their father's name misspelled needs a route to get it fixed;
/// what they must not have is the ability to fix it unilaterally, because the
/// same edit would let someone match their record to a forged certificate.
/// So the request is recorded here and a member of staff applies it.
model CorrectionRequest {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The Student field the request concerns, e.g. "fatherName".
  field          String
  /// Snapshot of the value at the time of asking, so staff can see whether the
  /// record has already been changed by the time they look at it.
  currentValue   String
  requestedValue String
  reason         String?

  /// PENDING | RESOLVED | REJECTED
  status       String    @default("PENDING")
  staffRemarks String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([studentId])
}

// ===========================================================================
// CONTENT MANAGEMENT
//
// Everything the public site shows that an administrator can change lives in
// the tables below. Public pages are still prerendered to static HTML — they
// read these tables at build time and are regenerated on demand when an admin
// saves (src/lib/content.ts, src/lib/revalidate.ts), so search engines always
// receive complete HTML and editors never wait for a redeploy.
// ===========================================================================

/// Site-wide settings, one JSON document per key: site, branding, home, menu,
/// footerLinks, recognition, examinations, certificateLayout. Shapes and
/// defaults are in src/lib/content-types.ts; every write is validated there.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A public file an administrator uploaded (logo, banner, photograph, PDF).
///
/// Distinct from Upload, which holds private documents (Aadhaar scans). Media
/// is served to everyone at /media/... with long-lived caching; Upload never
/// is. Keeping them in separate tables means a bug in one can never publish
/// the other.
///
/// storage "static": files shipped in public/ (the initial content).
/// storage "local":  files written by the admin panel to MEDIA_DIR.
model Media {
  id          String   @id @default(cuid())
  storage     String   @default("local")
  /// IMAGE | DOCUMENT
  kind        String
  filename    String
  contentType String
  bytes       Int
  width       Int?
  height      Int?
  /// Default alt text; slides and gallery photos carry their own.
  alt         String   @default("")
  /// JSON: [{ w, format, path }] — the encoded variants, for srcset.
  variants    String   @default("[]")
  /// For a document: its public path.
  path        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  slides        Slide[]
  galleryPhotos GalleryPhoto[]
  notices       Notice[]
}

model Faculty {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  summary    String
  /// JSON Block[] — the prose below the programme table.
  ///
  /// Same typed blocks as Page.body, never raw HTML, so an editor cannot
  /// inject script into the public site. Faculty pages carried only a one-line
  /// summary before this, which left them at about 175 words of real content
  /// and unable to compete for the course queries they exist to answer.
  body       String      @default("[]")
  sortOrder  Int         @default(0)
  published  Boolean     @default(true)
  programmes Programme[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Programme {
  id             String   @id @default(cuid())
  slug           String
  name           String
  award          String
  durationMonths Int
  /// Full-time | Part-time | Distance
  mode           String   @default("Full-time")
  eligibility    String
  intake         Int?
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  facultyId      String
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([facultyId, slug])
  @@index([facultyId, sortOrder])
}

/// A content page rendered at `path` by the [...slug] route.
model Page {
  id          String   @id @default(cuid())
  /// Always with leading and trailing slash: /about/foundation/
  path        String   @unique
  title       String
  description String
  intro       String?
  /// JSON Block[] — typed blocks, never raw HTML, so an editor cannot inject
  /// script into the public site.
  body        String   @default("[]")
  /// JSON Crumb[] (excluding Home).
  crumbs      String   @default("[]")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id        String   @id @default(cuid())
  /// YYYY-MM-DD
  date      String
  title     String
  /// Examination | Admission | General | Placement | Result
  category  String   @default("General")
  href      String?
  fileId    String?
  file      Media?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  pinned    Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
}

/// Homepage carousel slide.
model Slide {
  id               String   @id @default(cuid())
  mediaId          String
  media            Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  alt              String
  /// Text artwork: shown whole on this background, caption steps aside.
  banner           Boolean  @default(false)
  bannerBackground String?
  sortOrder        Int      @default(0)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GalleryCategory {
  id        String         @id @default(cuid())
  slug      String         @unique
  title     String
  blurb     String         @default("")
  sortOrder Int            @default(0)
  photos    GalleryPhoto[]
}

model GalleryPhoto {
  id         String          @id @default(cuid())
  mediaId    String
  media      Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  categoryId String
  category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  alt        String
  caption    String
  sortOrder  Int             @default(0)
  published  Boolean         @default(true)
  createdAt  DateTime        @default(now())
}
